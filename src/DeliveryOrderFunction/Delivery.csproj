<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Use .NET 8 isolated for Azure Functions v4 -->
    <TargetFramework>net8.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!-- Isolated worker -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.51.0" />

    <!-- App Insights for isolated worker: pin to 2.50.0 (2.51.0 not on nuget.org yet) -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.50.0" />

    <!-- Analyzer for isolated worker - required -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk"
                      Version="2.0.7"
                      OutputItemType="Analyzer"
                      PrivateAssets="all" />

    <!-- HTTP & Cosmos bindings -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.CosmosDB" Version="4.14.0" />

    <!-- Optional: worker service AI (keep if you’re using it) -->
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
  </ItemGroup>

</Project>